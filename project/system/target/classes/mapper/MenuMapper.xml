<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zm.system.mapper.MenuMapper">

    <!-- 根据角色ID列表查询已授权的菜单列表（去重、已启用、未删除） -->
    <select id="selectMenusByRoleIds" resultType="com.zm.system.entity.SysMenu">
        SELECT DISTINCT m.* FROM sys_menu m
        INNER JOIN sys_role_menu rm ON m.id = rm.menu_id
        WHERE rm.role_id IN
        <foreach collection="list" item="roleId" open="(" separator="," close=")">
            #{roleId}
        </foreach>
        AND m.status = 1 AND m.is_delete = 0
        ORDER BY m.sort
    </select>

    <!-- 查询所有未删除菜单，按排序字段升序排列 -->
    <select id="selectAllMenus" resultType="com.zm.system.entity.SysMenu">
        SELECT * FROM sys_menu WHERE is_delete = 0 ORDER BY sort
    </select>

</mapper>
